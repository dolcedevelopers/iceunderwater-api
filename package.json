{
  "name": "iceunderwater-api",
  "version": "1.0.0",
  "description": "ICE UNDERWATER REST API — supplier, driver and admin backends sharing the WordPress/WooCommerce MySQL database",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "migrate:down": "tsx src/db/migrate.ts --down",
    "start:prod": "node dist/db/migrate.js && node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "openapi": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.2",
    "argon2": "^0.43.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "jose": "^6.0.11",
    "mysql2": "^3.14.1",
    "pino": "^9.6.0",
    "sharp": "^0.34.2",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
