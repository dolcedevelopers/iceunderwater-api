NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Shared WordPress/WooCommerce MySQL (app user: DML only, no DDL)
# Remote from Render: use the external hostname, not localhost.
# URL-encode special characters in the password.
DATABASE_URL=mysql://iuw_api:CHANGE_ME@127.0.0.1:3306/iceunderwater
# Separate credentials for migrations only (can equal DATABASE_URL if one user has DDL)
DATABASE_MIGRATE_URL=mysql://iuw_migrate:CHANGE_ME@127.0.0.1:3306/iceunderwater
# Required when connecting to cPanel MySQL from Render (also accepted as ?ssl=true on the URL)
DATABASE_SSL=false

# WordPress site
WP_BASE_URL=https://iceunderwater.co.za
WP_BRIDGE_SECRET=CHANGE_ME_LONG_RANDOM
# Empty = secret-only auth (recommended for first Render deploy). Comma-separated later.
WP_BRIDGE_ALLOWED_IPS=

# WooCommerce REST API (writes only — never raw SQL to wp_ tables)
WC_CONSUMER_KEY=ck_xxx
WC_CONSUMER_SECRET=cs_xxx

# JWT — API-owned tokens after WordPress identity is resolved
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
# 12h access (tighten to 15m once the app has a refresh interceptor)
JWT_ACCESS_TTL_SECONDS=43200
JWT_REFRESH_TTL_SECONDS=2592000

# CORS allow-list (comma-separated origins). Native Expo clients often send no Origin.
CORS_ORIGINS=http://localhost:8081,exp://127.0.0.1:8081

# WooCommerce webhook delivery secret (must match the webhook in WP admin)
WC_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# Media uploads
UPLOAD_MAX_BYTES=5242880
DRIVER_PING_RETENTION_DAYS=90

# Rate limits
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Optional one-shot first owner (only when iuw_admins is empty). Remove after seed.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Owner
